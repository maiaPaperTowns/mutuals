# Python API and service environment. Keep real values in the backend secret store.
APP_ENV=production
STORAGE_BACKEND=spacetimedb
SPACETIME_GATEWAY_URL=http://127.0.0.1:8110
SPACETIME_GATEWAY_TOKEN=replace-with-a-long-random-secret
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_AUDIENCE=mhacks-live-map
CLERK_JWKS_URL=
# Exact website origins, comma-separated. Include local dev origins when needed.
WEB_ALLOWED_ORIGINS=https://your-web-app.vercel.app,http://localhost:5173
ORGANIZER_TOKEN=replace-with-a-separate-long-random-secret

# TypeScript gateway environment. The service token is generated by SpacetimeDB
# and its identity must be provisioned in the private agent_service table.
SPACETIMEDB_URI=wss://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=mhacks-live-map
SPACETIMEDB_SERVICE_TOKEN=replace-with-server-only-spacetimedb-token
SPACETIME_GATEWAY_HOST=127.0.0.1
SPACETIME_GATEWAY_PORT=8110

# LLM and per-agent identities. Generate a distinct random secret for each seed:
# python -c "import secrets; print(secrets.token_hex(32))"
ASI1_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=networking-roi
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=llama-text-embed-v2
PINECONE_DIMENSION=1024
PRE_EVENT_AGENT_SEED=
MATCHMAKER_AGENT_SEED=
PARTICIPANT_AGENT_SEED=
FOLLOWUP_AGENT_SEED=
REP_A_AGENT_SEED=
REP_B_AGENT_SEED=
# AGENT_MAILBOX=false  # use for local testing
