{
  "name": "mhacks-live-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "stdb:build": "spacetime build --module-path spacetimedb",
    "stdb:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "stdb:publish": "spacetime publish mhacks-live-map --server maincloud --module-path spacetimedb"
  },
  "dependencies": {
    "@clerk/react": "^6.17.5",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "spacetimedb": "^2.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.3"
  }
}
