# From https://app.photon.codes → project Settings. Leave unset to run in the terminal.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Concierge agent HTTP endpoint (Ziquan). Leave unset for the built-in fallback replies.
AGENT_URL=
PORT=8787
# Delay before the "was it worth it?" follow-up. Use ~20 for live demos.
FOLLOW_UP_SECONDS=2700
# Stand-in resume reader (used only while AGENT_URL is empty). console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Terry's live map (Vercel URL), sent when someone texts their zone
MAP_URL=
# Public https URL of this bridge (e.g. a cloudflared tunnel), needed for mini app cards
PUBLIC_URL=
# Secret teammates send as the x-bridge-key header to call /offer, /send, /stats, /profiles through the tunnel
BRIDGE_KEY=
# "link" (default): links open in Safari, nothing to install. "app": Photon mini app cards inside Messages (needs the free Spectrum iMessage app)
CARD_STYLE=link
# User database. Leave DYNAMODB_TABLE empty to keep users in photon/data/users.json on this laptop.
# With AWS: create the table with `npm run db:create`, then fill these (IAM user with DynamoDB access).
DYNAMODB_TABLE=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: Gemini writes the warm-intro opener after a match (template used otherwise)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
