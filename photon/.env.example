# From https://app.photon.codes → project Settings. Leave unset to run in the terminal.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Concierge agent HTTP endpoint (Ziquan). Leave unset for the built-in fallback replies.
AGENT_URL=
PORT=8787
# Delay before the "was it worth it?" follow-up. Use ~20 for live demos.
FOLLOW_UP_SECONDS=2700
